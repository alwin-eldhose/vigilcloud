# Copy this file to .env and fill in the values. .env is in .gitignore. Never commit it.
# No quotes around values. No comments at the end of a value line.

# Claude (inference). Used for the findings, the summary, the critic, image reading, and Q&A.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
VISION_MODEL=claude-sonnet-4-6
# Optional: a faster model for the summary step only. Defaults to CHAT_MODEL when unset.
# SUMMARY_MODEL=claude-haiku-5-5

# Akamai Managed PostgreSQL. Copy host, port, and password from the database's connection details.
PGHOST=
PGPORT=
PGUSER=akmadmin
PGPASSWORD=
PGDATABASE=defaultdb
PGSSLMODE=require

# Akamai Object Storage (S3 compatible). Use the endpoint for your bucket's region.
OBJ_ENDPOINT=https://us-ord-10.linodeobjects.com
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# The app also accepts these names instead of the ones above:
#   S3_ENDPOINT_URL, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET_NAME
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
